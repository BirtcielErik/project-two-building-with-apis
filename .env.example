# One More Chapter environment settings.
#
# Copy this file to .env (which git ignores) and fill in your own values:
#     cp .env.example .env
# Then run commands with:  uv run --env-file .env python manage.py runserver
#
# Tests do NOT need a .env file.

# Secret used to sign sessions and tokens. Required when DJANGO_DEBUG is off.
# Generate one with:
#     uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Debug mode shows detailed error pages. Only "true", "1", "yes", or "on" turn it on.
# Leave it off (blank or "false") anywhere other than your own computer.
DJANGO_DEBUG=true

# Comma-separated host names the site may be served from, e.g. "localhost,127.0.0.1".
# With debug on and this left blank, Django allows localhost automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Contact email sent to Open Library in the User-Agent header. Identified
# clients get a higher rate limit. Optional, but recommended.
OPENLIBRARY_CONTACT_EMAIL=
